<mxfile host="app.diagrams.net">
  <diagram id="groupes-roles" name="Groupes Entra et rôles AKS">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;tp-aks-sec-cluster : qui accède au cluster, et par quel chemin&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="zEntra" value="Microsoft Entra ID (tenant simplonformations.co)" style="swimlane;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="440" height="420" as="geometry" />
        </mxCell>
        <mxCell id="uMe" value="msaidi.ext@simplonformations.co&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;da606902-545b-44f5-8107-de279d199223&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="zEntra">
          <mxGeometry x="40" y="60" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uSteve" value="stheval@simplonformations.co&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;e7cbea33-8e5d-4a20-9823-d1281d600761&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="zEntra">
          <mxGeometry x="40" y="250" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gAdmins" value="&lt;b&gt;tp-aks-sec-admins&lt;/b&gt;&lt;br&gt;groupe de sécurité&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;05d2df4d-aa8c-4e6f-918d-d5bb0e99ed71&lt;/font&gt;&lt;br&gt;1 membre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="zEntra">
          <mxGeometry x="220" y="50" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gReaders" value="&lt;b&gt;tp-aks-sec-readers&lt;/b&gt;&lt;br&gt;groupe de sécurité&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;58f3f205-00e1-42ed-9082-4caa698ebd5b&lt;/font&gt;&lt;br&gt;1 membre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="zEntra">
          <mxGeometry x="220" y="240" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eMeAdm" value="membre" style="endArrow=block;html=1;" edge="1" parent="zEntra" source="uMe" target="gAdmins">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eStRd" value="membre" style="endArrow=block;html=1;" edge="1" parent="zEntra" source="uSteve" target="gReaders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="authn" value="Authentification : jeton Entra obtenu par kubelogin (-l azurecli), accès conditionnel et MFA du tenant" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="zEntra">
          <mxGeometry x="20" y="350" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="zAzure" value="Azure RBAC : assignations à la portée du cluster" style="swimlane;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="rCA" value="&lt;b&gt;Azure Kubernetes Service RBAC Cluster Admin&lt;/b&gt;&lt;br&gt;dataActions : managedClusters/*&lt;br&gt;+ listClusterUserCredential" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="zAzure">
          <mxGeometry x="30" y="50" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rRd" value="&lt;b&gt;Azure Kubernetes Service RBAC Reader&lt;/b&gt;&lt;br&gt;dataActions : .../read uniquement&lt;br&gt;pas de secrets, roles, rolebindings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="zAzure">
          <mxGeometry x="30" y="240" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="authz" value="Autorisation : webhook AKS qui appelle checkaccess d'Entra ID à chaque requête" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="zAzure">
          <mxGeometry x="20" y="350" width="340" height="50" as="geometry" />
        </mxCell>

        <mxCell id="eGA" value="assignation&lt;br&gt;ddc547eb-..." style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="gAdmins" target="rCA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eGR" value="assignation&lt;br&gt;57a85a93-..." style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="gReaders" target="rRd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="zAks" value="tp-aks-sec-cluster (msaidiRG, westeurope)" style="swimlane;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="60" width="420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Serveur d'API&lt;/b&gt;&lt;br&gt;aadProfile.managed = true&lt;br&gt;enableAzureRbac = true&lt;br&gt;adminGroupObjectIDs = null&lt;br&gt;disableLocalAccounts = true&lt;br&gt;authorizedIpRanges = aucune (O2 préparé)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="zAks">
          <mxGeometry x="30" y="40" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nsAll" value="Tous les namespaces&lt;br&gt;(default : demo-secret, demo-pod)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="zAks">
          <mxGeometry x="30" y="190" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nsProd" value="namespace prod&lt;br&gt;ResourceQuota prod-quota&lt;br&gt;LimitRange prod-limits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="zAks">
          <mxGeometry x="220" y="190" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k8sRbac" value="&lt;b&gt;Kubernetes RBAC (toujours actif, géré séparément)&lt;/b&gt;&lt;br&gt;aks-cluster-admin-binding : clusterAdmin, clusterUser (comptes locaux, désactivés)&lt;br&gt;aucun binding vers une identité Entra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="zAks">
          <mxGeometry x="30" y="290" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="eCA" value="lecture et écriture, cluster entier" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="rCA" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eRd" value="lecture seule, cluster entier" style="endArrow=block;html=1;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="rRd" target="nsAll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="zArm" value="Chemins indirects par ARM (hors des deux groupes, non supprimés)" style="swimlane;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="520" width="1360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="arm1" value="Owner / Contributor hérités (abonnement, msaidiRG, groupes d'administration)&lt;br&gt;managedClusters/write : peuvent réactiver les comptes locaux&lt;br&gt;listClusterUserCredential : peuvent télécharger le kubeconfig" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="zArm">
          <mxGeometry x="20" y="40" width="430" height="100" as="geometry" />
        </mxCell>
        <mxCell id="arm2" value="User Access Administrator / Role Based Access Control Administrator hérités&lt;br&gt;roleAssignments/write : peuvent s'attribuer un rôle AKS RBAC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="zArm">
          <mxGeometry x="470" y="40" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="arm3" value="Secours (break-glass) : Azure Kubernetes Service Contributor Role sur le cluster&lt;br&gt;--enable-local-accounts puis get-credentials --admin&lt;br&gt;à réserver à un compte de secours via PIM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="zArm">
          <mxGeometry x="910" y="40" width="430" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
